%% Purpose: runs post-provision against a temporary vCluster on the hub
%% Parameters: cluster-name and namespace are required; tier defaults to base
%% Order: the first four tasks run in order; a failed task stops them
%% Cleanup: delete-test-vcluster is the finally task; it runs after the fourth task and after a failed task
%% Name check: create, seed and delete exit 1 when a ClusterDeployment has the name or its ManagedCluster lacks cloud=vcluster
flowchart TB
    subgraph Config["Configuration"]
        load_config["load-config<br/>reads ConfigMap fleet-pipeline-config; its result pipeline-image is the image of the later tasks"]
    end

    subgraph Test["vCluster test"]
        create_test_vcluster["create-test-vcluster<br/>checks the name, runs vcluster create and<br/>writes the kubeconfig to the workspace"]
        seed_test_vcluster["seed-test-vcluster<br/>creates the labelled namespace NAME, two Secrets<br/>and the ManagedCluster with the tier label"]
        run_post_provision["run-post-provision<br/>creates a post-provision PipelineRun with<br/>openshift-cluster=false and waits for it"]
    end

    subgraph Cleanup["Cleanup"]
        delete_test_vcluster["delete-test-vcluster<br/>finally task: deletes the ManagedCluster, the Route, the vCluster, the labelled namespace NAME, the CronJob and the Secret NAME-spoke-kubeconfig"]
    end

    load_config --> create_test_vcluster
    create_test_vcluster --> seed_test_vcluster
    seed_test_vcluster --> run_post_provision
    run_post_provision --> delete_test_vcluster

    classDef src fill:#e6f6f4,stroke:#1f8f84,color:#000
    classDef core fill:#ecf2ff,stroke:#3b6fd8,color:#000

    class load_config src
    class create_test_vcluster,seed_test_vcluster,run_post_provision,delete_test_vcluster core
