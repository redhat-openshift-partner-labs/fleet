%% Trigger: a push to main of fleet-clusters that adds deprovision/NAME-archive
%% Order: every task runs after the task before it; a failed task stops the run
%% Stuck IAM: cleanup-hub-artifacts keeps the namespace and fails when IAM resources remain after 10 minutes, unless orphan-stuck-iam is true
sequenceDiagram
    participant Pipe as deprovision
    participant Hub as Hub API
    participant Hive
    participant XP as Crossplane
    participant AWS
    participant GH as GitHub

    rect rgb(246, 248, 250)
        Note over Pipe,GH: load-config
        Pipe->>Hub: get ConfigMap fleet-pipeline-config
        Hub-->>Pipe: pipeline parameters
    end

    rect rgb(246, 248, 250)
        Note over Pipe,GH: terminate-pod-vms
        Pipe->>Hub: read tier label; for coco:<br/>delete the peer-pods AccessKey
        Pipe->>AWS: for coco: terminate pod VMs, delete the pod VM image and its snapshots
        AWS-->>Pipe: no pod VMs left
    end

    rect rgb(246, 248, 250)
        Note over Pipe,GH: delete-cluster-resources
        Pipe->>Hub: delete KlusterletAddonConfig,<br/>ManagedCluster, MachinePools
        Pipe->>Hub: delete ClusterDeployment
        Hub-->>Pipe: infra-id
    end

    rect rgb(246, 248, 250)
        Note over Pipe,GH: wait-hive-uninstall
        Pipe->>Hub: wait for the ClusterDeployment<br/>to be gone, timeout 30m
        Hive->>AWS: uninstall: delete the cluster's AWS resources
        AWS-->>Hive: resources deleted
        Hive->>Hub: remove finalizer
        Hub-->>Pipe: ClusterDeployment gone
    end

    rect rgb(246, 248, 250)
        Note over Pipe,GH: cleanup-hub-artifacts
        Pipe->>Hub: delete Certificate, ClusterIssuer<br/>and the cert-manager Secret
        Pipe->>XP: delete the cluster's IAM resources, wait up to 10m
        XP->>AWS: delete IAM users,<br/>keys, roles, policies
        XP-->>Pipe: IAM resources gone
        Pipe->>Hub: delete CronJob and<br/>namespace NAME
    end

    rect rgb(246, 248, 250)
        Note over Pipe,GH: verify-deprovision
        Pipe->>Hub: get namespace, ManagedCluster,<br/>ClusterDeployment, CronJob
        Pipe->>XP: list the cluster's IAM resources
        XP-->>Pipe: none remain
    end

    rect rgb(246, 248, 250)
        Note over Pipe,GH: create-deployment-status
        Pipe->>Hub: read the GitHub App key Secret<br/>and the IAM cleanup report
        Pipe->>GH: create deployment in fleet-clusters (environment deprovision), set status success
    end
