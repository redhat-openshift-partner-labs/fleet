%% Trigger: the trigger-provision task of the pre-provision pipeline creates the PipelineRun with the repository URL and revision it cloned
%% Order: tasks are shown in an order the pipeline allows; the task flowchart shows which tasks run in parallel
%% Credential mode: scope-aws-credentials is skipped unless metadata.yaml sets aws-credentials-mode: scoped
%% Failure: a failed task stops the run; trigger-post-provision does not run
sequenceDiagram
    participant Pipe as provision
    participant Hub as Hub API
    participant Hive
    participant XP as Crossplane
    participant AWS
    participant Git

    rect rgb(246, 248, 250)
        Note over Pipe,Git: load-config
        Pipe->>Hub: get ConfigMap fleet-pipeline-config
        Hub-->>Pipe: pipeline parameters
    end

    rect rgb(246, 248, 250)
        Note over Pipe,Git: git-clone
        Pipe->>Git: clone fleet-clusters at the revision of pre-provision
        Git-->>Pipe: provision/NAME/ in the workspace
    end

    rect rgb(246, 248, 250)
        Note over Pipe,Git: read-cluster-metadata
        Git-->>Pipe: metadata.yaml values from the clone
    end

    rect rgb(246, 248, 250)
        Note over Pipe,Git: apply-cluster-crs
        Pipe->>Hub: apply the hive overlay: ClusterDeployment,<br/>MachinePool, ManagedCluster and related CRs
    end

    rect rgb(246, 248, 250)
        Note over Pipe,Git: wait-for-hive-ready
        Pipe->>Hub: wait for condition Provisioned on<br/>the ClusterDeployment, timeout 1h15m
        Hive->>AWS: install the cluster
        AWS-->>Hive: cluster installed
        Hive->>Hub: write the admin kubeconfig Secret, set Provisioned
        Hub-->>Pipe: Provisioned
    end

    opt aws-credentials-mode is scoped
        rect rgb(246, 248, 250)
            Note over Pipe,Git: scope-aws-credentials
            Pipe->>Hub: read the infra ID from<br/>the ClusterDeployment
            Pipe->>AWS: find the cluster VPC by its ownership tag
            Pipe->>XP: set the infra ID and the VPC in<br/>the cluster's IAM policies and roles
            XP->>AWS: update the IAM policies and roles
        end
    end

    rect rgb(246, 248, 250)
        Note over Pipe,Git: wait-for-managed-cluster
        Pipe->>Hub: wait for condition ManagedClusterJoined<br/>on the ManagedCluster
        Hub-->>Pipe: joined
    end

    rect rgb(246, 248, 250)
        Note over Pipe,Git: extract-spoke-kubeconfig
        Pipe->>Hub: read the admin kubeconfig Secret<br/>named by the ClusterDeployment
        Hub-->>Pipe: kubeconfig in the workspace
    end

    rect rgb(246, 248, 250)
        Note over Pipe,Git: read-cluster-tier
        Pipe->>Hub: get the tier label of the ManagedCluster
        Hub-->>Pipe: base, virt, ai or coco
    end

    rect rgb(246, 248, 250)
        Note over Pipe,Git: label-for-post-provision
        Pipe->>Hub: label the ManagedCluster provisioned=true
    end

    rect rgb(246, 248, 250)
        Note over Pipe,Git: trigger-post-provision
        Pipe->>Hub: read baseDomain from the ClusterDeployment
        Pipe->>Hub: create the PipelineRun of the<br/>post-provision pipeline, timeout 5h
    end
