%% Trigger: trigger-post-provision of the provision pipeline creates the PipelineRun; the EventListener starts one for a request whose body holds action: post-provision
%% Order: tasks are shown in an order the pipeline allows; the task flowchart shows which tasks run in parallel
%% openshift-cluster: false in a vCluster test run; the tasks marked openshift-cluster is true are then skipped
%% Tier: every tier applies the base overlay; the virt, ai or coco tasks run for a cluster of that tier
%% Timeout: 5h for the whole run
sequenceDiagram
    participant Pipe as post-provision
    participant Hub as Hub API
    participant Spoke as Spoke API
    participant KC as Keycloak
    participant AWS
    participant PB as PrivateBin
    participant Git

    rect rgb(246, 248, 250)
        Note over Pipe,Git: load-config
        Pipe->>Hub: get ConfigMap fleet-pipeline-config
        Hub-->>Pipe: pipeline parameters
    end

    rect rgb(246, 248, 250)
        Note over Pipe,Git: git-clone
        Pipe->>Git: clone the fleet repository
        Git-->>Pipe: workloads/ in the workspace
    end

    rect rgb(246, 248, 250)
        Note over Pipe,Git: extract-spoke-kubeconfig
        Pipe->>Hub: read the admin kubeconfig Secret<br/>named by the ClusterDeployment
        Hub-->>Pipe: kubeconfig in the workspace
    end

    rect rgb(246, 248, 250)
        Note over Pipe,Git: save-spoke-kubeconfig
        Pipe->>Hub: write Secret NAME-spoke-kubeconfig
    end

    rect rgb(246, 248, 250)
        Note over Pipe,Git: create-cluster-cronjob
        Pipe->>Hub: apply CronJob NAME in namespace default
    end

    opt openshift-cluster is true
        rect rgb(246, 248, 250)
            Note over Pipe,Git: register-keycloak-client
            Pipe->>Hub: read the Keycloak admin Secret
            Pipe->>KC: create or update the OIDC client of the cluster
            Pipe->>Hub: write the client ID and secret<br/>to a hub Secret
        end

        rect rgb(246, 248, 250)
            Note over Pipe,Git: configure-spoke-oauth
            Pipe->>Hub: read the OIDC client Secret
            Pipe->>Spoke: apply the OIDC client Secret, the htpasswd Secret and the OAuth CR
        end

        rect rgb(246, 248, 250)
            Note over Pipe,Git: create-cluster-issuer
            Pipe->>Hub: copy the cluster's AWS key into<br/>a Secret for cert-manager
            Pipe->>Hub: create ClusterIssuer letsencrypt-NAME
        end

        rect rgb(246, 248, 250)
            Note over Pipe,Git: request-ssl-cert
            Pipe->>Hub: create Certificate<br/>NAME-wildcard-certificate
        end

        rect rgb(246, 248, 250)
            Note over Pipe,Git: wait-for-ssl-ready
            Pipe->>Hub: wait for condition Ready on<br/>the Certificate, timeout 20m
            Hub->>AWS: cert-manager writes the DNS-01 records to Route53
            Hub-->>Pipe: Certificate Ready
        end

        rect rgb(246, 248, 250)
            Note over Pipe,Git: extract-cert-material
            Pipe->>Hub: copy tls.crt and tls.key into<br/>Secret NAME-leaf-cert
        end

        rect rgb(246, 248, 250)
            Note over Pipe,Git: configure-spoke-default-cert
            Pipe->>Hub: read Secret NAME-leaf-cert
            Pipe->>Spoke: apply the Secret in openshift-ingress, patch the default IngressController
        end
    end

    opt tier is base, virt, ai or coco
        rect rgb(246, 248, 250)
            Note over Pipe,Git: apply-base-workloads
            Pipe->>Spoke: apply the output of kustomize build workloads/base
        end
    end

    opt tier is virt
        rect rgb(246, 248, 250)
            Note over Pipe,Git: apply-virt-workloads
            Pipe->>Spoke: install Node Feature Discovery, then OpenShift Virtualization
        end

        rect rgb(246, 248, 250)
            Note over Pipe,Git: add-baremetal-workers
            Pipe->>Hub: create a bare-metal worker MachinePool
        end
    end

    opt tier is ai
        rect rgb(246, 248, 250)
            Note over Pipe,Git: apply-ai-workloads
            Pipe->>Spoke: install the OpenShift AI 2.x or 3.x operators, and the GPU operators for nvidia-gpu
        end

        opt ai-accelerator is nvidia-gpu
            rect rgb(246, 248, 250)
                Note over Pipe,Git: add-ai-workers
                Pipe->>Hub: create a GPU worker MachinePool
            end
        end
    end

    opt tier is coco
        rect rgb(246, 248, 250)
            Note over Pipe,Git: prepare-podvm-aws
            Pipe->>Spoke: read the first worker node
            Pipe->>AWS: read its VPC, subnet and security groups, open the pod VM ports
        end

        rect rgb(246, 248, 250)
            Note over Pipe,Git: build-podvm-image-aws
            Pipe->>Spoke: read the pod VM disk image<br/>of the operator
            Pipe->>AWS: reuse or build the pod VM AMI of the cluster, timeout 2h
            AWS-->>Pipe: AMI ID
        end

        rect rgb(246, 248, 250)
            Note over Pipe,Git: apply-coco-workloads
            Pipe->>Spoke: write peer-pods-secret and the peer pods configuration
            Pipe->>Spoke: install sandboxed containers and the KataConfig, timeout 2h
        end
    end

    opt openshift-cluster is true
        rect rgb(246, 248, 250)
            Note over Pipe,Git: configure-spoke-rbac
            Pipe->>Spoke: create group cluster-admins and its ClusterRoleBinding to cluster-admin
        end

        rect rgb(246, 248, 250)
            Note over Pipe,Git: create-access-paste
            Pipe->>Hub: read the kubeadmin password
            Pipe->>PB: upload console URL, kubeadmin password and kubeconfig
            Pipe->>Hub: store the paste URL and its<br/>password in a Secret
        end

        rect rgb(246, 248, 250)
            Note over Pipe,Git: finalize-spoke
            Pipe->>Spoke: delete leftover installer pods and the kubeadmin Secret
        end
    end
